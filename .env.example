# Copie para .env e ajuste. Nunca versione o arquivo .env real.
# Estes valores são só para desenvolvimento local.

# --- Versões fixadas das imagens (nunca use :latest) ---
REDIS_VERSION=7.4.7-alpine
KAFKA_VERSION=4.3.2
POSTGRES_VERSION=17.7-alpine

# --- Serviço de inferência ---
MODEL_VERSION=mock-1.0.0
CPU_WORK_MS=20

# --- Redis (cache + lock distribuído) ---
REDIS_PASSWORD=redis-dev

# --- Kafka (KRaft) ---
# ID do cluster; gere outro com:
#   docker run --rm apache/kafka:4.3.2 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=oUF6rOg3QT28-au2ggBgCQ
KAFKA_TOPIC_LOTES=transacoes.lote
KAFKA_TOPIC_DLQ=transacoes.lote.dlq

# --- PostgreSQL: um banco por serviço ---
TRANSACOES_DB_USER=transacoes
TRANSACOES_DB_PASSWORD=transacoes-dev
PREDICOES_DB_USER=predicoes
PREDICOES_DB_PASSWORD=predicoes-dev

# --- API Gateway ---
JWT_SECRET=troque-este-segredo-em-dev
